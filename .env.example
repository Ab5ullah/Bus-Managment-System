DEBUG=True
SECRET_KEY=django-insecure-bus-ticket-management-system-secret-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# Database Configuration (PostgreSQL Docker)
DB_ENGINE=postgresql
DB_NAME=busms_db
DB_USER=busms_user
DB_PASSWORD=busms_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis Cache / Broker
REDIS_URL=redis://127.0.0.1:6379/0

# Financial Engine Settings
TAX_RATE_PERCENTAGE=5.00
SERVICE_FEE_FIXED=50.00
CURRENCY_CODE=PKR

# CORS
CORS_ALLOW_ALL_ORIGINS=True

# JWT Settings
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
